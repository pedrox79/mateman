<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mante - Panel Principal</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="navbar">
    <h2>📐 Mante</h2>
    <div>
      <span id="userGreeting">Hola</span>
      <a href="ranking.html" class="btn secondary sm">🏆 Ranking Global</a>
    </div>
  </header>

  <main class="container">
    <h2>Selecciona un Curso</h2>
    <p>Cada curso contiene 100 problemas progresivos.</p>

    <div class="grid">
      <!-- Curso Suma -->
      <div class="course-card">
        <h3>➕ Sumas</h3>
        <p>Desde números simples hasta millones, paréntesis y decimales.</p>
        <div class="progress-container">
          <div class="progress-bar" id="bar-suma" style="width: 0%;"></div>
        </div>
        <small id="text-suma">0 / 100 Completados</small>
        <button onclick="startCourse('suma')" class="btn primary full-width">Ir al Curso</button>
      </div>

      <!-- Curso Resta -->
      <div class="course-card">
        <h3>➖ Restas</h3>
        <p>Aprende a sustraer cifras pequeñas, grandes y con decimales.</p>
        <div class="progress-container">
          <div class="progress-bar" id="bar-resta" style="width: 0%;"></div>
        </div>
        <small id="text-resta">0 / 100 Completados</small>
        <button onclick="startCourse('resta')" class="btn primary full-width">Ir al Curso</button>
      </div>

      <!-- Curso Multiplicación -->
      <div class="course-card">
        <h3>✖️ Multiplicación</h3>
        <p>Tablas, multiplicación por miles, jerarquía y decimales.</p>
        <div class="progress-container">
          <div class="progress-bar" id="bar-multiplicacion" style="width: 0%;"></div>
        </div>
        <small id="text-multiplicacion">0 / 100 Completados</small>
        <button onclick="startCourse('multiplicacion')" class="btn primary full-width">Ir al Curso</button>
      </div>
    </div>
  </main>

  <script>
    const user = localStorage.getItem('mante_user');
    if(!user) window.location.href = 'index.html';
    document.getElementById('userGreeting').innerText = `Hola, ${user}`;

    const courses = ['suma', 'resta', 'multiplicacion'];
    courses.forEach(c => {
      const level = localStorage.getItem(`mante_prog_${c}`) || 0;
      document.getElementById(`bar-${c}`).style.width = `${level}%`;
      document.getElementById(`text-${c}`).innerText = `${level} / 100 Completados`;
    });

    function startCourse(course) {
      window.location.href = `course.html?type=${course}`;
    }
  </script>
</body>
</html>
